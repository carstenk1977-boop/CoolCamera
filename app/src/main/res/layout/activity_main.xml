<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <com.stylecam.filters.StyleCamGLView
        android:id="@+id/glView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.stylecam.ui.SplitOverlayView
        android:id="@+id/splitOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@null"
        android:src="@drawable/focus_ring"
        android:visibility="gone" />

    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFFFF"
        android:visibility="gone" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_btn"
            android:contentDescription="Settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_round_btn"
            android:contentDescription="Torch"
            android:padding="10dp"
            android:src="@drawable/ic_flash" />

        <TextView
            android:id="@+id/styleLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnFlip"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_btn"
            android:contentDescription="Switch camera"
            android:padding="10dp"
            android:src="@drawable/ic_flip" />
    </LinearLayout>

    <TextView
        android:id="@+id/fpsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:background="#88000000"
        android:fontFamily="monospace"
        android:padding="4dp"
        android:textColor="#B6FF8A"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/importBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="IMPORTED PHOTO"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnImportSave"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="SAVE"
            android:textColor="@color/amber"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnImportClose"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="CLOSE"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom stack -->
    <LinearLayout
        android:id="@+id/bottomStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_gradient"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/controlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/presetScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/presetRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageButton
                android:id="@+id/btnGallery"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round_btn"
                android:contentDescription="Import photo"
                android:padding="12dp"
                android:src="@drawable/ic_gallery" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnHold"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="HOLD\nORIGINAL"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/btnShutter"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:contentDescription="Shutter">

                <View
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/shutter_ring" />

                <View
                    android:id="@+id/shutterDot"
                    android:duplicateParentState="true"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter_dot" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnSplit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round_btn"
                android:contentDescription="Split compare"
                android:padding="12dp"
                android:src="@drawable/ic_compare" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnTune"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round_btn"
                android:contentDescription="Adjust filter"
                android:padding="12dp"
                android:src="@drawable/ic_tune" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/styleScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/styleRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="StyleCam needs the camera to show live artistic filters.\nNothing leaves your phone."
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnGrant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Allow camera" />
    </LinearLayout>
</FrameLayout>
